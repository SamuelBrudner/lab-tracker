# Copy this file to .env, replace every example value, and run:
#   chmod 600 deployments/dedicated-instance/.env
#
# Preserve the database identity and password for an existing deployment.
# Database URL components must be URL-safe.
DEDICATED_COMPOSE_PROJECT_NAME=lab-tracker-dedicated
DEDICATED_APP_NAME=dedicated-lab-tracker
DEDICATED_PUBLIC_BASE_URL=https://lab-tracker.example.org
DEDICATED_HOST_PORT=18000
DEDICATED_POSTGRES_DB=example_lab_tracker
DEDICATED_POSTGRES_USER=example_lab_tracker_user
DEDICATED_POSTGRES_PASSWORD=replace-with-existing-url-safe-database-password

# Choose values approved for this deployment. These are intentionally generic
# examples rather than a copy of any operator's live model policy.
DEDICATED_OPENAI_MODEL=gpt-4o-mini
DEDICATED_OPENAI_REASONING_EFFORT=medium
DEDICATED_OPENAI_REASONING_MODE=standard
DEDICATED_OPENAI_TIMEOUT_SECONDS=120

# Release-gate timing is also deployment policy.
DEDICATED_RELEASE_HEALTH_ATTEMPTS=20
DEDICATED_RELEASE_HEALTH_INTERVAL_SECONDS=3
DEDICATED_RELEASE_CONNECT_TIMEOUT_SECONDS=5
DEDICATED_RELEASE_MAX_TIME_SECONDS=20
