LAB_TRACKER_GRAPH_DRAFT_PROVIDER=openai
LAB_TRACKER_GRAPH_DRAFT_BACKGROUND_ENABLED=false
LAB_TRACKER_GRAPH_DRAFT_SCHEDULER_ENABLED=false
LAB_TRACKER_OPENAI_MODEL=replace-with-reviewed-model
LAB_TRACKER_OPENAI_REASONING_EFFORT=
LAB_TRACKER_OPENAI_REASONING_MODE=
LAB_TRACKER_OPENAI_TIMEOUT_SECONDS=60
LAB_TRACKER_REVIEW_EMAIL_ENABLED=false
LAB_TRACKER_REVIEW_EMAIL_TRANSPORT=external
# Accounts come from invitations or an admin; no anonymous viewer signup.
LAB_TRACKER_AUTH_PUBLIC_VIEWER_REGISTRATION_ENABLED=false
