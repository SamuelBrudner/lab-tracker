{
  "inputs": [
    {
      "type": "promptString",
      "id": "lt-token",
      "description": "Lab Tracker MCP token (lpat_), the supported credential - leave blank only if auth is disabled",
      "password": true
    },
    {
      "type": "promptString",
      "id": "lt-username",
      "description": "Deprecated: Lab Tracker username (use an lpat_ token instead) - leave blank"
    },
    {
      "type": "promptString",
      "id": "lt-password",
      "description": "Deprecated: Lab Tracker password (use an lpat_ token instead) - leave blank",
      "password": true
    }
  ],
  "servers": {
    "lab-tracker": {
      "type": "stdio",
      "command": "lt-mcp",
      "env": {
        "LAB_TRACKER_BASE_URL": "http://127.0.0.1:8000",
        "LAB_TRACKER_MCP_API_KEY": "${input:lt-token}",
        "LAB_TRACKER_MCP_USERNAME": "${input:lt-username}",
        "LAB_TRACKER_MCP_PASSWORD": "${input:lt-password}",
        "FASTMCP_NO_BANNER": "1",
        "FASTMCP_QUIET": "1",
        "FASTMCP_SILENT": "1",
        "MCP_QUIET": "1"
      }
    }
  }
}
