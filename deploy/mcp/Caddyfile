# Private Lab Tracker MCP reverse proxy.
#
# Replace mcp.lab.internal with the tailnet/VPN hostname you will serve. This
# file intentionally does not configure permissive CORS; the MCP endpoint should
# stay private. The MCP ASGI process enforces a distinct inbound bearer before
# FastMCP receives a request; this proxy terminates TLS and preserves that header.

mcp.lab.internal {
    @badhost not host mcp.lab.internal
    respond @badhost 421

    # Placeholder allowlist: confirm real GitHub Copilot IDE Origin values
    # against live logs before enforcing in production.
    @badorigin {
        header Origin *
        not header_regexp Origin ^https://(github\.com|[A-Za-z0-9.-]+\.githubcopilot\.com)$
    }
    respond @badorigin 403

    log {
        output stdout
        format filter {
            request>headers>Authorization delete
            request>headers>Proxy-Authorization delete
            request>headers>Cookie delete
        }
    }

    # The @badhost/@badorigin checks above are the public Host/Origin policy.
    # lt-mcp also validates Host/Origin (DNS-rebinding protection) against a
    # loopback-only allowlist by default, so forward the upstream host and drop
    # the Origin Caddy already vetted. To have lt-mcp check the public names
    # instead, delete these two header_up lines and set, on the lt-mcp process,
    # LAB_TRACKER_MCP_ALLOWED_HOSTS=mcp.lab.internal and
    # LAB_TRACKER_MCP_ALLOWED_ORIGINS to the same origins allowed above.
    reverse_proxy 127.0.0.1:9000 {
        header_up Host {upstream_hostport}
        header_up -Origin
        header_up X-Forwarded-Proto {scheme}
    }
}
