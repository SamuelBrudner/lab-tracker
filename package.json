{
  "name": "lab-tracker-frontend",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build:frontend:dev": "node scripts/build-frontend.mjs --dev",
    "build:pages-demo": "node scripts/build-pages-demo.mjs",
    "check:frontend-contracts": "uv run python scripts/generate_frontend_openapi_types.py --check",
    "dev:frontend": "node scripts/build-frontend.mjs --watch",
    "lint:frontend": "eslint \"src/lab_tracker/frontend_src/**/*.{js,jsx}\"",
    "shoot:screenshots": "node scripts/shoot-screenshots.mjs",
    "test:e2e": "playwright test",
    "test:frontend": "vitest run",
    "typecheck:frontend": "tsc --project tsconfig.frontend-contracts.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2"
  }
}
