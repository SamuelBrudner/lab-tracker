# Application settings
LAB_TRACKER_APP_NAME=lab-tracker
LAB_TRACKER_ENVIRONMENT=production
LAB_TRACKER_LOG_LEVEL=INFO
LAB_TRACKER_DATABASE_URL=postgresql+psycopg://lab_tracker:lab_tracker@postgres:5432/lab_tracker
LAB_TRACKER_FILE_STORAGE_PATH=/app/data/file_storage
LAB_TRACKER_NOTE_STORAGE_PATH=/app/data/note_storage
LAB_TRACKER_AUTH_SECRET_KEY=
LAB_TRACKER_AUTH_TOKEN_TTL_MINUTES=720
LAB_TRACKER_AUTH_INVITE_TTL_HOURS=168
LAB_TRACKER_AUTH_RATE_LIMIT_ATTEMPTS=10
LAB_TRACKER_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LAB_TRACKER_AUTH_PUBLIC_VIEWER_REGISTRATION_ENABLED=true
# Local default is false; non-local environments default to true and cannot disable auth.
LAB_TRACKER_AUTH_ENABLED=true
# Public URL used in invitation links. If unset, the request host is used.
LAB_TRACKER_PUBLIC_BASE_URL=
# Optional: one-time admin bootstrap for fresh deployments (only honored when users table is empty)
LAB_TRACKER_BOOTSTRAP_ADMIN_TOKEN=
# local (default), first_run, or never
LAB_TRACKER_BOOTSTRAP_ADMIN_TOKEN_DISCLOSURE=local

# Maximum raw upload size for notes, dataset files, and visualization assets.
LAB_TRACKER_MAX_UPLOAD_BYTES=104857600

# Optional OpenAI-compatible provider settings for graph drafts and voice transcription.
# Create an API key at https://platform.openai.com/api-keys.
LAB_TRACKER_OPENAI_API_KEY=
LAB_TRACKER_OPENAI_MODEL=gpt-4o-mini
LAB_TRACKER_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
LAB_TRACKER_OPENAI_BASE_URL=https://api.openai.com/v1
LAB_TRACKER_OPENAI_TIMEOUT_SECONDS=60

# Postgres service settings for docker-compose
POSTGRES_DB=lab_tracker
POSTGRES_USER=lab_tracker
POSTGRES_PASSWORD=lab_tracker

# Optional migration retry settings used by docker-entrypoint.sh
MIGRATION_MAX_ATTEMPTS=30
MIGRATION_SLEEP_SECONDS=2

# Lab Tracker MCP service-client settings (credentials are only required when auth is enabled)
LAB_TRACKER_MCP_BASE_URL=http://127.0.0.1:8000
LAB_TRACKER_MCP_USERNAME=
LAB_TRACKER_MCP_PASSWORD=
LAB_TRACKER_MCP_TIMEOUT_SECONDS=10

# Export-only Dolt mirror settings
LAB_TRACKER_DOLT_BIN=dolt
LAB_TRACKER_DOLT_MIRROR_PATH=.lab-tracker-dolt
