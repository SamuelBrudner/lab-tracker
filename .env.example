# Application settings
LAB_TRACKER_APP_NAME=lab-tracker
LAB_TRACKER_ENVIRONMENT=production
LAB_TRACKER_LOG_LEVEL=INFO
# Canonical public/API origin. Browser UI is available at <origin>/app.
LAB_TRACKER_BASE_URL=
LAB_TRACKER_DATABASE_URL=postgresql+psycopg://lab_tracker:lab_tracker@postgres:5432/lab_tracker
LAB_TRACKER_FILE_STORAGE_PATH=/app/data/file_storage
LAB_TRACKER_NOTE_STORAGE_PATH=/app/data/note_storage
LAB_TRACKER_AUTH_SECRET_KEY=
LAB_TRACKER_AUTH_TOKEN_TTL_MINUTES=720
LAB_TRACKER_AUTH_INVITE_TTL_HOURS=168
LAB_TRACKER_AUTH_RATE_LIMIT_ATTEMPTS=10
LAB_TRACKER_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LAB_TRACKER_AUTH_PUBLIC_VIEWER_REGISTRATION_ENABLED=true
# Local default is false; non-local environments default to true and cannot disable auth.
LAB_TRACKER_AUTH_ENABLED=true
# Local default is false; non-local deployments default to true. Stores fixed-shape local usage metadata only.
LAB_TRACKER_USAGE_EVENTS=true
# Optional: one-time admin bootstrap for fresh deployments (only honored when users table is empty)
LAB_TRACKER_BOOTSTRAP_ADMIN_TOKEN=
# local (default), first_run, or never
LAB_TRACKER_BOOTSTRAP_ADMIN_TOKEN_DISCLOSURE=local

# Maximum raw upload size for notes, dataset files, and visualization assets.
LAB_TRACKER_MAX_UPLOAD_BYTES=104857600

# Versioned operator-owned project/group store-authority grants. Unset or exactly
# empty denies every grant. Supply the compact JSON envelope documented in
# docs/configuration.md; malformed or whitespace-only values fail startup.
LAB_TRACKER_STORE_AUTHORITY_GRANTS_JSON=

# Host-local roots allowed for local artifact resolution and local store health.
# Separate entries with the host platform's path separator (":" on POSIX, ";"
# on Windows). Unset, empty, or whitespace-only denies every root at runtime.
# Example in this container: /app/data
LAB_TRACKER_RESOLVER_ALLOWED_ROOTS=
# Optional read-only content-hash recovery for moved/renamed local artifacts.
LAB_TRACKER_RESOLVER_RECOVERY=false
# Maximum candidate files returned by one recovery scan (4096 hard maximum).
LAB_TRACKER_RESOLVER_RECOVERY_MAX_FILES=4096
# Maximum root/child-directory attempts admitted by one scan (4096 hard maximum).
LAB_TRACKER_RESOLVER_RECOVERY_MAX_DIRECTORIES=4096
# Cumulative accepted payload allowance across one direct attempt and its
# recovery candidates (512 MiB hard maximum). A fatal EOF proof may read one
# additional byte, which is discarded and terminates the resolution.
LAB_TRACKER_RESOLVER_RECOVERY_MAX_BYTES=536870912
# Optional internal HTTP(S) destinations for artifact resolution and HTTP store
# health. Public destinations are allowed only when every resolved address is
# globally routable. Internal access requires BOTH an exact
# scheme+host+effective-port authority and CIDRs containing every
# resolved/literal address; wildcards and suffixes are not supported. Invalid
# entries fail application startup.
# Example: https://files.lab.example:443,http://archive.lan:8080
LAB_TRACKER_RESOLVER_HTTP_ALLOWED_AUTHORITIES=
# Example: 10.42.0.0/16,fd42:1234::/48
LAB_TRACKER_RESOLVER_HTTP_ALLOWED_NETWORKS=
# Comma-separated exact rclone remote names. Rclone artifact resolution and
# rclone store health deny every remote while this is empty. Entries are not
# whitespace-trimmed; empty, malformed, NFKC-delimiter-unsafe, or duplicate
# entries fail application startup without echoing the configured value.
# Example: lab-onedrive,archive-s3
LAB_TRACKER_RCLONE_ALLOWED_REMOTES=
# Comma-separated structural Git grants. Git resolution and Git store health
# deny every remote while this is empty. Each entry is an exact HTTPS, ssh://,
# git://, or SCP-style remote prefix; scheme, normalized host, effective port,
# SSH user, path style, and whole path segments are matched without wildcards.
# Terminal-dot hosts, embedded credentials, query/fragment components, and
# malformed entries fail application startup.
# Example: https://git.example/lab,ssh://git@git.internal:2222/lab
LAB_TRACKER_GIT_ALLOWED_REMOTES=
# Total wall-clock budget for one HTTP artifact resolution or HTTP store-health
# probe, including DNS, connect/TLS, headers, and redirects. Artifact resolution
# also includes body verification and hashing (max 86400).
LAB_TRACKER_RESOLVER_HTTP_DEADLINE_SECONDS=30
# Execution/verification budget for one local, rclone, or Git artifact
# resolution, or one local, rclone, or Git store-health probe (max 86400).
# Failed-process cleanup has a separate fixed 1.25-second grace.
LAB_TRACKER_RESOLVER_SUBPROCESS_DEADLINE_SECONDS=30

# Admission control for POST /external-artifacts/resolve. Requests are rejected
# immediately with one generic 429 response when either process-local limit is
# full; they never wait for a resolution slot. Keep the global value at or
# below 32 and keep the per-actor value no greater than the global value.
# Artifact and store-health global limits must add up to no more than 32.
LAB_TRACKER_ARTIFACT_RESOLUTION_GLOBAL_IN_FLIGHT_LIMIT=8
LAB_TRACKER_ARTIFACT_RESOLUTION_PER_ACTOR_IN_FLIGHT_LIMIT=2

# Admission and short-lived result reuse for GET /data-stores/{id}/health.
# Limits and cache state are process-local. Requests never wait for admission;
# same-store followers may wait only for the bounded single-flight deadline.
LAB_TRACKER_STORE_HEALTH_GLOBAL_IN_FLIGHT_LIMIT=4
LAB_TRACKER_STORE_HEALTH_PER_ACTOR_IN_FLIGHT_LIMIT=1
LAB_TRACKER_STORE_HEALTH_CACHE_MAX_ENTRIES=256
LAB_TRACKER_STORE_HEALTH_CACHE_TTL_SECONDS=10
LAB_TRACKER_STORE_HEALTH_SINGLEFLIGHT_WAIT_SECONDS=10

# Optional paid background transcription of every new audio capture. Disabled
# by default: enabling sends raw audio and capture_hint to the configured
# OpenAI or Google provider. No built-in rate limit or daily budget is present.
LAB_TRACKER_AUTO_TRANSCRIBE_VOICE_CAPTURES=false

# Optional OpenAI-compatible provider settings for graph drafts and voice transcription.
# Create an API key at https://platform.openai.com/api-keys.
LAB_TRACKER_OPENAI_API_KEY=
LAB_TRACKER_OPENAI_MODEL=gpt-4o-mini
LAB_TRACKER_OPENAI_REASONING_EFFORT=
LAB_TRACKER_OPENAI_REASONING_MODE=
LAB_TRACKER_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
LAB_TRACKER_OPENAI_BASE_URL=https://api.openai.com/v1
LAB_TRACKER_OPENAI_TIMEOUT_SECONDS=60

# Optional privacy-safe daily-review email alerts. Alerts are per-user and opt-in.
# "external" queues content-free mail for a mailbox-owned worker; "smtp" starts
# the built-in sender and requires the SMTP fields below.
LAB_TRACKER_REVIEW_EMAIL_ENABLED=false
LAB_TRACKER_REVIEW_EMAIL_TRANSPORT=external
LAB_TRACKER_REVIEW_EMAIL_WORKER_POLL_SECONDS=10
LAB_TRACKER_REVIEW_EMAIL_CLAIM_LEASE_SECONDS=300
LAB_TRACKER_REVIEW_EMAIL_MAX_ATTEMPTS=8
LAB_TRACKER_REVIEW_EMAIL_LINK_TTL_MINUTES=1440
LAB_TRACKER_REVIEW_EMAIL_SMTP_HOST=
LAB_TRACKER_REVIEW_EMAIL_SMTP_PORT=587
LAB_TRACKER_REVIEW_EMAIL_SMTP_USERNAME=
LAB_TRACKER_REVIEW_EMAIL_SMTP_PASSWORD=
LAB_TRACKER_REVIEW_EMAIL_SMTP_FROM_ADDRESS=
LAB_TRACKER_REVIEW_EMAIL_SMTP_TLS_MODE=starttls
LAB_TRACKER_REVIEW_EMAIL_SMTP_TIMEOUT_SECONDS=10

# Postgres service settings for docker-compose
POSTGRES_DB=lab_tracker
POSTGRES_USER=lab_tracker
POSTGRES_PASSWORD=lab_tracker

# Optional migration retry settings used by deploy/docker-entrypoint.sh
MIGRATION_MAX_ATTEMPTS=3
MIGRATION_SLEEP_SECONDS=2

# Lab Tracker MCP service-client settings. It uses LAB_TRACKER_BASE_URL above;
# LAB_TRACKER_MCP_BASE_URL remains a compatibility fallback.
LAB_TRACKER_MCP_API_KEY=
LAB_TRACKER_MCP_TOKEN=
LAB_TRACKER_MCP_USERNAME=
LAB_TRACKER_MCP_PASSWORD=
LAB_TRACKER_MCP_TIMEOUT_SECONDS=10

# Optional hosted read-only MCP endpoint for private VPN/tailnet deployments.
# The compose mcp service is published only on host loopback at this port.
LT_MCP_READONLY_TOKEN=
LAB_TRACKER_MCP_HOST_PORT=9000
LAB_TRACKER_MCP_TRANSPORT=stdio
LAB_TRACKER_MCP_HOST=127.0.0.1
LAB_TRACKER_MCP_PORT=8000
LAB_TRACKER_MCP_PATH=/mcp

# Export-only Dolt mirror settings
LAB_TRACKER_DOLT_BIN=dolt
LAB_TRACKER_DOLT_MIRROR_PATH=.lab-tracker-dolt
