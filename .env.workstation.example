# Copy to .env.workstation and fill in real values on the graph workstation.
# Do not commit the copied file.

LAB_TRACKER_APP_NAME=lab-tracker
LAB_TRACKER_ENVIRONMENT=production
LAB_TRACKER_AUTH_ENABLED=true
LAB_TRACKER_AUTH_SECRET_KEY=<generate-a-long-random-secret>
LAB_TRACKER_BOOTSTRAP_ADMIN_TOKEN=<one-time-admin-bootstrap-token>
LAB_TRACKER_AUTH_TOKEN_TTL_MINUTES=720

# Recommended for the workstation runtime once Postgres is running.
LAB_TRACKER_DATABASE_URL=postgresql+psycopg://lab_tracker:lab_tracker@127.0.0.1:5432/lab_tracker

# Keep durable local files outside temporary checkout paths if this becomes canonical.
LAB_TRACKER_NOTE_STORAGE_PATH=./note_storage
LAB_TRACKER_FILE_STORAGE_PATH=./file_storage
